{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Bank Dev Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "bank.app:app",
        "--app-dir",
        "src",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Pytest: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
